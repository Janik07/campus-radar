{
  "name": "campus-radar",
  "version": "1.0.0",
  "description": "Campus Radar \u2014 all AITU student events in one place",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:local": "node scripts/local-db.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}