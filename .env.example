# Copy to .env for local development. On Render, set these in the dashboard.
DATABASE_URL=postgres://radar:radar@localhost:54329/radar
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:3000
EMAIL_DOMAIN=astanait.edu.kz
# Comma-separated emails that become administrators on sign-in
ADMIN_EMAILS=your.email@astanait.edu.kz
# true = show the sign-in code on screen when no email service is set (for demos)
DEMO_MODE=true
# Optional: real emails through https://resend.com
RESEND_API_KEY=
MAIL_FROM=Campus Radar <onboarding@resend.dev>
# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Secret for the external cron that triggers reminders: /api/cron/tick?key=...
CRON_SECRET=change-me-too
APP_TIMEZONE=Asia/Almaty
